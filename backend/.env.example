# Troque "SUA_SENHA_POSTGRES" pela senha informada na instalação do PostgreSQL.
# Se a senha contiver @, #, : ou /, use codificação de URL (ou escolha senha simples para o banco de teste).
DATABASE_URL=postgresql://postgres:SUA_SENHA_POSTGRES@localhost:5432/lousa_login
PORT=3000
FRONTEND_URL=http://localhost:8100
# Gere um valor único com o comando descrito no GUIA_PASSO_A_PASSO.md
JWT_SECRET=COLE_AQUI_UMA_CHAVE_ALEATORIA_LONGA

# Credenciais fictícias, somente para demonstração LOCAL.
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@lousa.local
SEED_ADMIN_PASSWORD=TroqueEstaSenhaAdmin123
SEED_USER_NAME=Professor Demonstração
SEED_USER_EMAIL=professor@lousa.local
SEED_USER_PASSWORD=TroqueEstaSenhaProf123
